rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(resourceOwnerId) {
      return signedIn() && request.auth.uid == resourceOwnerId;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if owns(resource.data.ownerId);
      allow update: if owns(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if owns(resource.data.ownerId);

      match /scans/{scanId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
